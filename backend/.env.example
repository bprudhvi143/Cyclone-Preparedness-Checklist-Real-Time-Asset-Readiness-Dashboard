# System Mode (dev, prod)
ENV_MODE=dev

# Database Configuration
# For Docker deployment use: postgresql+asyncpg://gvmc_admin:gvmc_secure_pass_2026@db:5432/gvmc_disaster_db
DATABASE_URL=postgresql+asyncpg://gvmc_admin:gvmc_secure_pass_2026@localhost:5432/gvmc_disaster_db

# Cache Configuration
REDIS_URL=redis://localhost:6379/0

# Authentication Keys (Generate high-entropy key in production)
JWT_SECRET=9ee8f38c35d97f5a34e8f7f2b1d6f1ba7e48b3017a022be3f5c71c6d3de8658d
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

